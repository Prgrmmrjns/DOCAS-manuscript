digraph pathophysiology {
  rankdir=TB;
  node [shape=box, style=filled, fontname="Arial"];

  // Signal nodes (blue)
  anchor_age [label="Age", fillcolor="#a0c4e8"];
  Epinephrine_avg [label="Epinephrine", fillcolor="#a0c4e8"];
  Norepinephrine_avg [label="Norepinephrine", fillcolor="#a0c4e8"];
  Dobutamine_avg [label="Dobutamine", fillcolor="#a0c4e8"];
  Foley_sum [label="Urine Output", fillcolor="#a0c4e8"];
  BMI [label="BMI", fillcolor="#a0c4e8"];
  diabetes [label="Diabetes", fillcolor="#a0c4e8"];
  hypertension [label="Hypertension", fillcolor="#a0c4e8"];
  anemia [label="Anemia", fillcolor="#a0c4e8"];
  obesity [label="Obesity", fillcolor="#a0c4e8"];
  Sepsis3 [label="Sepsis", fillcolor="#a0c4e8"];
  NSURG [label="Surgical", fillcolor="#a0c4e8"];
  NMED [label="Medical", fillcolor="#a0c4e8"];
  CMED [label="Comorbidities", fillcolor="#a0c4e8"];

  // System nodes (orange)
  Cardiovascular [label="Cardiovascular System\nVasopressor-Driven Hemodynamic Instability", fillcolor="#ffb366"];
  Renal [label="Renal System\nFluid Overload & Renal Dysfunction", fillcolor="#ffb366"];
  Metabolic [label="Metabolic & Endocrine System\nNutritional Status & Comorbidities", fillcolor="#ffb366"];
  Infectious [label="Infectious & Inflammatory System\nSepsis-Induced Organ Dysfunction", fillcolor="#ffb366"];
  Demographic [label="Demographic & Comorbidity System\nBaseline Patient Risk Profile", fillcolor="#ffb366"];

  // Outcome node (green)
  Mortality [label="ICU Mortality Risk\n(Survival vs. Death)", fillcolor="#81c784"];

  // Edges from signals to systems
  anchor_age -> Demographic;
  Epinephrine_avg -> Cardiovascular;
  Norepinephrine_avg -> Cardiovascular;
  Dobutamine_avg -> Cardiovascular;
  Foley_sum -> Renal;
  BMI -> Metabolic;
  diabetes -> Metabolic;
  hypertension -> Metabolic;
  anemia -> Metabolic;
  obesity -> Metabolic;
  Sepsis3 -> Infectious;
  NSURG -> Demographic;
  NMED -> Demographic;
  CMED -> Demographic;

  // Cross-system interactions
  Cardiovascular -> Renal [label="Vasopressor-Induced Renal Hypoperfusion"];
  Cardiovascular -> Metabolic [label="Catecholamine-Mediated Metabolic Stress"];
  Renal -> Metabolic [label="Uremia & Fluid Overload Worsening Metabolic State"];
  Infectious -> Metabolic [label="Sepsis-Induced Hypermetabolic State"];
  Demographic -> Cardiovascular [label="Age & Comorbidity-Linked Vasopressor Sensitivity"];
  Demographic -> Metabolic [label="Comorbidity-Driven Metabolic Dysregulation"];

  // Systems to outcome
  Cardiovascular -> Mortality;
  Renal -> Mortality;
  Metabolic -> Mortality;
  Infectious -> Mortality;
  Demographic -> Mortality;
}