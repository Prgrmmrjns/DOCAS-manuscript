digraph synthetic_pipeline {
    rankdir=TB;
    graph [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif",
        fontsize=15,
        splines=true,
        nodesep=0.22,
        ranksep=0.38,
        bgcolor=white,
        pad=0.2
    ];
    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif",
        fontsize=13,
        shape=box,
        style="filled,rounded",
        margin="0.14,0.09",
        penwidth=1.4
    ];
    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif",
        fontsize=11,
        penwidth=1.5,
        arrowsize=0.8
    ];

    // ── High-level pipeline (general, no profile listing) ───────────
    mimic [
        label="MIMIC-IV ICU dataset\n(demographics, comorbidities, labs, treatments)",
        fillcolor="#d9ecff", color="#2b6cb0", fontcolor="#0f2746"
    ];
    model_ctx [
        label="Train LightGBM + model context\n(SHAP summary, task descriptor, error audit)",
        fillcolor="#ffe5cc", color="#c05621", fontcolor="#4a1f00"
    ];
    llm [
        label="LLM profile generation\n(Mistral)",
        fillcolor="#f3e8ff", color="#6d28d9", fontcolor="#2e1065",
        fontsize=14
    ];
    templates [
        label="10 profile templates\n(high-risk, low-risk, stress-test)",
        fillcolor="#d1fae5", color="#2f855a", fontcolor="#123d2a"
    ];
    synth [
        label="Synthetic cohort (~1,000 rows)\nBias functions: shift, scale, affine, set_prevalence",
        fillcolor="#fef9c3", color="#ca8a04", fontcolor="#78350f",
        fontsize=13
    ];
    outputs [
        label="Outputs on same cohort\nTreeSHAP (marginal) + shapiq (interactions)",
        fillcolor="#d9ecff", color="#2b6cb0", fontcolor="#0f2746"
    ];

    // primary flow
    mimic     -> model_ctx [color="#2b6cb0"];
    model_ctx -> llm       [color="#c05621"];
    llm       -> templates [color="#6d28d9"];
    templates -> synth     [color="#2f855a", label="100 rows each"];
    synth     -> outputs   [color="#2b6cb0"];

    // provenance cue
    mimic -> synth [color="#9ca3af", style=dashed, penwidth=1.2, arrowsize=0.7, label="sampled basis rows"];
}
